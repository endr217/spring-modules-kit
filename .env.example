# Copy to .env and fill in. Never commit .env.

# Database (PostgreSQL)
POSTGRES_URL=jdbc:postgresql://localhost:5432/app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
HIBERNATE_DDL_AUTO=update

# Auth - at least 64 random bytes (HS512), e.g. `openssl rand -base64 64`
JWT_SECRET=change-me
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# OAuth2 (optional)
OAUTH2_GOOGLE_CLIENT_ID=
OAUTH2_GOOGLE_CLIENT_SECRET=
OAUTH2_FACEBOOK_CLIENT_ID=
OAUTH2_FACEBOOK_CLIENT_SECRET=

# Payments
STRIPE_API_KEY=sk_test_change-me
STRIPE_WEBHOOK_SECRET=whsec_change-me
PAYSERA_PROJECT_ID=
PAYSERA_SIGN_PASSWORD=
PAYMENTS_SUCCESS_URL=http://localhost:3000/checkout/success
PAYMENTS_CANCEL_URL=http://localhost:3000/checkout/cancel

# Run Seeder beans on startup
APP_SEED_ENABLED=false
